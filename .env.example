# Server
PORT=4100
NODE_ENV=development

# MongoDB (use a different db name than quizmania while testing standalone)
MONGODB_URI=mongodb://127.0.0.1:27017/arena

# Socket.IO (client reads this at build time)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4100

# Identity. The main project issues the JWT; this service only verifies it.
# Leave AUTH_JWT_SECRET empty and ALLOW_DEV_AUTH=true to run without the auth project.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=
ALLOW_DEV_AUTH=true

# Comma-separated user ids treated as contest admins.
ADMIN_USER_IDS=dev-admin

# Judge
JUDGE_CONCURRENCY=3
JUDGE_SUBMIT_COOLDOWN_MS=5000
JUDGE_WORKDIR=/tmp/arena-judge

# Campus code execution engine (see "Code execution engine" in README).
# engine = run all C on the campus engine; local = bubblewrap on this host.
JUDGE_BACKEND=engine
QUERY_SERVER_URL=https://10.5.1.36/grader
# Server-side secret from the engine administrator. Never commit a real value.
QUERY_SERVER_API_KEY=
# Path to the SCIS Connect Internal CA certificate. TLS verification stays on.
QUERY_SERVER_CA_CERT=./certs/scis-connect-ca.crt
# The engine runs 4 programs at once for everyone; stay below that.
ENGINE_CONCURRENCY=3
